# =============================================================================
# Configuration Parapharma Assistant
# =============================================================================
# Copiez ce fichier vers .env et remplissez vos valeurs
#   cp .env.example .env
#
# Les valeurs indiquées ici sont les défauts recommandés pour un setup
# Mac + robot Pepper + API OpenAI.
# =============================================================================


# -----------------------------------------------------------------------------
# OpenAI API  (OBLIGATOIRE)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-api-key-here

# Désactiver le proxy système si vous avez des problèmes de connexion OpenAI
# OPENAI_DISABLE_PROXY=1

# Proxy WebSocket (si réseau d'entreprise)
# OPENAI_WS_PROXY=


# -----------------------------------------------------------------------------
# Robot Pepper  (laisser PEPPER_IP vide pour mode simulation)
# -----------------------------------------------------------------------------
PEPPER_IP=
PEPPER_PORT=9559

# Forcer le tunnel SSH si la connexion directe NAOqi échoue
PEPPER_FORCE_SSH_BRIDGE=0

# Forcer les certificats certifi pour les requêtes HTTPS vers Pepper
PEPPER_FORCE_CERTIFI_CA=1


# -----------------------------------------------------------------------------
# Mode d'exécution
# -----------------------------------------------------------------------------
# Options: development, production, simulation, test
RUN_MODE=development


# -----------------------------------------------------------------------------
# Serveur WebSocket Tablette
# -----------------------------------------------------------------------------
TABLET_HOST=0.0.0.0
TABLET_PORT=8765

# URL explicite de la tablette (si besoin de se connecter depuis Pepper)
# TABLET_URL=

# Activer les questions texte depuis la tablette (en plus du vocal)
TABLET_TEXT_QUESTION_ENABLED=0


# -----------------------------------------------------------------------------
# Mode vocal — Pipeline principal
# -----------------------------------------------------------------------------

# Durée d'écoute maximale après "Commencer la question" (secondes)
PEPPER_VOICE_LISTEN_DURATION_S=12

# Durée maximale d'une session d'enregistrement manuel (secondes)
PEPPER_VOICE_MANUAL_MAX_S=3600

# Délai avant d'afficher "Aucune question captée" si rien n'arrive (secondes)
# Normalement court-circuité par le callback on_no_speech
PEPPER_VOICE_NO_TRANSCRIPT_DELAY_S=7.5

# Activer les logs détaillés du pipeline vocal (recommandé en test)
PEPPER_VOICE_TRACE=1

# Activer le filtre anti-parasites sur les transcriptions
PEPPER_VOICE_TRANSCRIPT_FILTER=0


# -----------------------------------------------------------------------------
# Mode vocal — Transcription Whisper (OpenAI API)
# -----------------------------------------------------------------------------

# IMPORTANT : mettre à 0 pour utiliser l'API OpenAI Whisper directement
# (mettre à 1 uniquement sur Mac Apple Silicon avec MLX installé)
OPENAI_HTTP_LOCAL_STT_ENABLED=0

# Modèle de transcription OpenAI
# Laisser vide = whisper-1 (défaut)
# OPENAI_HTTP_TRANSCRIPTION_MODEL=whisper-1

# Prompt de contexte envoyé à Whisper (améliore la précision sur termes métier)
# OPENAI_HTTP_TRANSCRIPTION_PROMPT=parapharmacie, crème solaire, shampoing, soin capillaire

# Modèle LLM pour les réponses aux questions (fallback HTTP)
# Laisser vide = gpt-4o-mini (défaut)
# OPENAI_HTTP_FALLBACK_MODEL=gpt-4o-mini

# Durée minimale d'une utterance pour être envoyée à Whisper (secondes)
# Augmenter si des bruits courts déclenchent des transcriptions parasites
OPENAI_HTTP_MIN_UTTERANCE_S=0.35

# Seuil RMS de détection de parole (mode automatique VAD)
# Augmenter si le micro capte trop de bruit ambiant
OPENAI_HTTP_SPEECH_THRESHOLD=0.010

# Durée de silence pour couper une utterance (mode automatique VAD, secondes)
OPENAI_HTTP_END_SILENCE_S=0.90

# Gain appliqué au micro avant traitement (1.0 = pas de modification)
OPENAI_HTTP_INPUT_GAIN=1.0

# Durée max du buffer audio en mode manuel (secondes)
OPENAI_HTTP_MANUAL_BUFFER_S=240

# Répondre quand même si l'API LLM échoue (répète la transcription)
OPENAI_HTTP_OFFLINE_ANSWER_ON_ERROR=0


# -----------------------------------------------------------------------------
# Mode vocal — Capture audio Pepper (ALAudioRecorder)
# -----------------------------------------------------------------------------

# Utiliser uniquement le micro frontal de Pepper (recommandé)
# 0 = tous les micros (4 canaux, 48kHz) / 1 = micro frontal seul (1 canal, 16kHz)
PEPPER_AUDIO_RECORDER_FRONT_ONLY=1

# Canal mono à utiliser quand front_only=0 (ordre NAOqi: 0=L, 1=R, 2=Front, 3=Rear)
OPENAI_HTTP_MONO_CHANNEL_INDEX=2

# Chemin de l'enregistrement WAV sur le robot (laisser vide = auto)
# PEPPER_AUDIO_RECORDER_PATH=/home/nao/recordings/pepper_capture_chunk.wav

# Activer les logs détaillés de la capture audio (chunks, RMS, taux)
# Utile pour diagnostiquer des coupures audio inexpliquées
PEPPER_AUDIO_DEBUG=0

# Utiliser l'ancien mode subscribe ALAudioDevice au lieu de ALAudioRecorder
PEPPER_AUDIO_USE_SUBSCRIBE=0

# Désactiver le Realtime OpenAI (force le mode fallback HTTP)
# OPENAI_REALTIME_DISABLED=1


# -----------------------------------------------------------------------------
# Vision / VLM
# -----------------------------------------------------------------------------
# Modèle VLM local (sur Mac Apple Silicon avec MLX)
VLM_MODEL=mlx-community/Qwen2-VL-2B-Instruct-4bit

# Backend VLM: auto, mlx, openai, disabled
PEPPER_VLM_BACKEND=auto

# Désactiver complètement le VLM (utilise uniquement code-barres)
# PEPPER_VLM_DISABLED=1

# Seuil de confiance pour accepter directement un résultat VLM (sans code-barres)
PEPPER_VLM_HIGH_MIN_MATCH=0.72

# Permettre au VLM de répondre directement si confiance haute (sans confirmation code-barres)
PEPPER_VLM_ALLOW_DIRECT_HIGH=0

# Charger le modèle VLM au démarrage (plus lent à démarrer mais réponse immédiate)
PEPPER_VLM_EAGER_LOAD=1

# Ignorer le classifier cheveux/corps
PEPPER_VLM_SKIP_HAIR_CLASSIFIER=0

# Chemin local vers un modèle VLM (si pas téléchargé via HF)
# PEPPER_VLM_LOCAL_PATH=

# Logs détaillés VLM
# PEPPER_VLM_DEBUG=1

# Ignorer le health-check MLX au démarrage
# PEPPER_SKIP_MLX_HEALTHCHECK=1

# Répertoire cache Hugging Face
# HF_HOME=/path/to/hf_cache

# Seuils de confiance VLM (ancienne config, redondant avec VLM_HIGH_MIN_MATCH)
VLM_HIGH_CONFIDENCE=0.85
VLM_MEDIUM_CONFIDENCE=0.60

# Modèle OpenAI Vision (si VLM_BACKEND=openai)
# OPENAI_VISION_MODEL=gpt-4o
OPENAI_VISION_TIMEOUT_S=25
OPENAI_VISION_MAX_RETRIES=1
OPENAI_VISION_RETRY_DELAY_S=0.4
OPENAI_VISION_INFERENCE_ATTEMPTS=2
OPENAI_VISION_FALLBACK_ENABLED=1


# -----------------------------------------------------------------------------
# Caméra Pepper
# -----------------------------------------------------------------------------
# ID(s) caméra: 0=haut, 1=bas, 2=profondeur
PEPPER_CAMERA_IDS=0

# Résolution: 0=160x120, 1=320x240, 2=640x480, 3=1280x960
PEPPER_CAMERA_RESOLUTION=2

# FPS caméra
PEPPER_CAMERA_FPS=5


# -----------------------------------------------------------------------------
# Pipeline code-barres
# -----------------------------------------------------------------------------

# Mode streaming (recommandé) : capture en continu au lieu d'images fixes
PEPPER_BARCODE_STREAM_MODE=1

# Nombre de tentatives de scan (mode non-streaming)
PEPPER_BARCODE_ATTEMPTS=20
PEPPER_BARCODE_MIN_ATTEMPTS=3
PEPPER_BARCODE_ATTEMPT_COOLDOWN=0.2

# Nombre de frames par tentative
PEPPER_BARCODE_FRAMES=4
PEPPER_BARCODE_FRAME_INTERVAL=0.14

# Résolution caméra dédiée au scan (laisser vide = PEPPER_CAMERA_RESOLUTION)
# PEPPER_BARCODE_CAMERA_RESOLUTION=3

# Utiliser OpenAI Vision en priorité pour lire les codes-barres
PEPPER_BARCODE_OPENAI_FIRST=1

# Paramètres OpenAI Vision pour les codes-barres
OPENAI_BARCODE_TIMEOUT_S=14
OPENAI_BARCODE_MAX_RETRIES=1
OPENAI_BARCODE_RETRY_DELAY_S=0.3
OPENAI_BARCODE_INFERENCE_ATTEMPTS=2
OPENAI_BARCODE_MAX_IMAGES=3
OPENAI_BARCODE_MAX_VIEWS_PER_IMAGE=3
OPENAI_BARCODE_REQUIRED_DETECTIONS=1

# Activer la recherche approfondie si le scan standard échoue
# PEPPER_BARCODE_DEEP_SEARCH=1

# Exiger que le produit soit en base de données pour valider le scan
PEPPER_BARCODE_REQUIRE_PRODUCT_IN_DB=0

# Conserver les images de scan pour debug
PEPPER_SCAN_KEEP_IMAGES=1

# Répertoire de dump des images de scan (debug)
# PEPPER_BARCODE_DUMP_DIR=logs/scan_debug

# Logs détaillés code-barres
# PEPPER_BARCODE_DEBUG=1

# Timeout global de l'opération de scan (0 = pas de limite)
PEPPER_SCAN_OPERATION_TIMEOUT_S=0

# Autoriser un nombre illimité de scans consécutifs
PEPPER_SCAN_ALLOW_UNLIMITED=0


# -----------------------------------------------------------------------------
# Pipeline visuel (reconnaissance produit par image sans code-barres)
# -----------------------------------------------------------------------------
PEPPER_VISUAL_FRAMES=3
PEPPER_VISUAL_FRAME_INTERVAL=0.18
PEPPER_VISUAL_MIN_ATTEMPTS=3
PEPPER_VISUAL_ATTEMPT_COOLDOWN=0.2

# Fallback vers code-barres si la reconnaissance visuelle échoue
PEPPER_VISUAL_ERROR_FALLBACK_BARCODE=1


# -----------------------------------------------------------------------------
# Audio — Paramètres généraux (Realtime / VAD)
# -----------------------------------------------------------------------------
# Preset VAD: default, hesitant, fast, noisy, quiet, elderly
VAD_PRESET=default

# Voix OpenAI TTS Realtime: nova, shimmer, alloy, echo, fable, onyx
TTS_VOICE=shimmer


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.jsonl
